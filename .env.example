GROQ_API_KEY=put_your_new_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b

SAMBANOVA_API_KEY=put_your_sambanova_api_key_here
SAMBANOVA_DEFAULT_MODEL=Meta-Llama-3.3-70B-Instruct

GEMINI_API_KEY=put_your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=put_your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=x-ai/grok-4.5

MISTRAL_API_KEY=put_your_mistral_api_key_here
MISTRAL_DEFAULT_MODEL=mistral-small-latest

COHERE_API_KEY=put_your_cohere_api_key_here
COHERE_DEFAULT_MODEL=command-r-plus-08-2024

SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=sqlite:///personal_ai_workspace.db

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
DEFAULT_PROVIDER=groq

DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096
MAX_CONTEXT_MESSAGES=80
MAX_MESSAGE_CHARACTERS=20000
MAX_IMPORT_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=20
